{
    "schema_version": "1.0",
    "workflow": {
        "id": "winflow-demo",
        "name": "WinFlow Feature Demonstration",
        "version": "1.0",
        "description": "Demonstrates variables, loops, clipboard interaction, and verifications."
    },
    "trigger": {
        "type": "windows_notification",
        "match": {
            "application": {"mode": "contains", "value": "DemoApp"},
            "title": {"mode": "contains", "value": "Start Demo"}
        }
    },
    "variables": {
        "demo_counter": 0,
        "max_iterations": 3
    },
    "steps": [
        {
            "action": "set_variable",
            "params": {"name": "demo_counter", "value": 0},
            "description": "Initialize Counter"
        },
        {
            "action": "clipboard_clear",
            "description": "Clear the clipboard before test"
        },
        {
            "action": "clipboard_write",
            "text": "WinFlow Demo Started: {{trigger_event.title}}",
            "description": "Write initial state to clipboard"
        },
        {
            "action": "wait",
            "seconds": 1.0,
            "description": "Brief pause to ensure clipboard is ready"
        },
        {
            "action": "while",
            "description": "Read the clipboard until a value is captured (runs once; bounded)",
            "max_iterations": 3,
            "condition": {
                "type": "ALL",
                "conditions": [
                    {"operator": "not_exists", "left": "{{ variables.current_clip }}"}
                ]
            },
            "steps": [
                {
                    "action": "clipboard_read",
                    "variable_name": "current_clip",
                    "description": "Read what is in clipboard"
                },
                {
                    "action": "wait",
                    "seconds": 0.5
                }
            ]
        },
        {
            "action": "if",
            "description": "Condition check example",
            "condition": {
                "type": "ALL",
                "conditions": [
                    {"operator": "equals", "left": "{{ variables.demo_counter }}", "right": 0}
                ]
            },
            "then": [
                {
                    "action": "clipboard_write",
                    "text": "Condition branch completed."
                }
            ],
            "else": []
        }
    ]
}
